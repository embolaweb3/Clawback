# ── Clawback environment configuration ──────────────────────────────────────
# Copy to .env and fill in.

# ── App ──────────────────────────────────────────────────────────────────────
# Server-side symmetric key (32-byte hex) used to encrypt sensitive case
# payloads at rest in the local data store. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAWBACK_ENCRYPTION_KEY=
# Where the local JSON case store lives.
# On a serverless host (Vercel, Lambda, etc.) the deployed filesystem is
# read-only outside /tmp — FileCaseStore's mkdir/writeFile will throw
# EACCES on a fresh case unless this points under /tmp there, e.g.:
#   CLAWBACK_DATA_DIR=/tmp/clawback-data
# /tmp on serverless is per-instance and ephemeral, so this is a stopgap,
# not durable persistence — see LIMITATIONS.md §8/ARCHITECTURE.md for the
# real fix (swap FileCaseStore for a Postgres/KV-backed CaseStore; the
# interface is already shaped for that swap).
CLAWBACK_DATA_DIR=.clawback-data
